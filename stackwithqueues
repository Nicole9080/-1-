        "from collections import deque\n",
        "from typing import Any, Optional\n",
        "\n",
        "class StackWithQueues:\n",
        "    def __init__(self):\n",
        "        self.queue1 = deque()  # Основная очередь\n",
        "        self.queue2 = deque()  # Вспомогательная очередь\n",
        "\n",
        "    def push(self, item: Any) -> None:\n",
        "        # Добавляем элемент в пустую вспомогательную очередь\n",
        "        self.queue2.append(item)\n",
        "\n",
        "        # Перекладываем все элементы из основной очереди во вспомогательную\n",
        "        while self.queue1:\n",
        "            self.queue2.append(self.queue1.popleft())\n",
        "\n",
        "        # Меняем очереди местами\n",
        "        self.queue1, self.queue2 = self.queue2, self.queue1\n",
        "\n",
        "    def pop(self) -> Optional[Any]:\n",
        "        if not self.queue1:\n",
        "            raise IndexError(\"Стек пуст\")\n",
        "        return self.queue1.popleft()\n",
        "\n",
        "    def peek(self) -> Optional[Any]:\n",
        "        if not self.queue1:\n",
        "            raise IndexError(\"Стек пуст\")\n",
        "        return self.queue1[0]"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def test_stack():\n",
        "    stack = StackWithQueues()\n",
        "\n",
        "    try:\n",
        "        print(\"Тестирование стека:\")\n",
        "\n",
        "        # Добавление элементов\n",
        "        stack.push(1)\n",
        "        stack.push(2)\n",
        "        stack.push(3)\n",
        "\n",
        "        # Удаление элементов\n",
        "        print(f\"Удален элемент: {stack.pop()}\")  # 3\n",
        "        print(f\"Удален элемент: {stack.pop()}\")  # 2\n",
        "\n",
        "    except IndexError as e:\n",
        "        print(f\"Ошибка: {e}\")\n",
        "\n",
        "test_stack()"
